@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Promijeni lozinku";
}

<div class="manage-page">
    <nav>
        <partial name="_ManageNav" />
    </nav>

    <div class="manage-content">
        <div class="manage-heading">
            <h1 class="manage-heading__title">Promijeni lozinku</h1>
            <p class="manage-heading__sub">Postavi novu lozinku za svoj račun</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="manage-alert manage-alert--info">
                <i class="fa-solid fa-circle-check"></i> @Model.StatusMessage
            </div>
        }

        <div class="manage-card">
            <h2 class="manage-card__title"><i class="fa-solid fa-lock"></i> Nova lozinka</h2>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="manage-alert manage-alert--danger" style="margin-bottom:1rem;"></div>

                <div class="manage-field">
                    <label asp-for="Input.OldPassword"></label>
                    <input asp-for="Input.OldPassword" type="password" autocomplete="current-password" />
                    <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                </div>

                <div class="manage-field">
                    <label asp-for="Input.NewPassword"></label>
                    <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>

                <div class="manage-field">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="manage-btn-row">
                    <button type="submit" class="manage-btn manage-btn--primary">
                        <i class="fa-solid fa-floppy-disk"></i> Spremi lozinku
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
