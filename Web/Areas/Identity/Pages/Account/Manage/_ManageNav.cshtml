@using Data.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@{
    var navUser = await UserManager.GetUserAsync(User);
    var isGoogleUser = navUser != null &&
        (await UserManager.GetLoginsAsync(navUser)).Any(l => l.LoginProvider == "Google");
    var hasPassword = navUser != null && await UserManager.HasPasswordAsync(navUser);
}
<ul class="manage-nav">
    <li class="manage-nav__item">
        <a class="manage-nav__link @ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index">
            <i class="fa-solid fa-user"></i> Profil
        </a>
    </li>
    @if (hasPassword)
    {
        <li class="manage-nav__item">
            <a class="manage-nav__link @ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword">
                <i class="fa-solid fa-lock"></i> Promijeni lozinku
            </a>
        </li>
    }
    <li class="manage-nav__item">
        <a class="manage-nav__link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" asp-page="./TwoFactorAuthentication">
            <i class="fa-solid fa-shield-halved"></i> Dvofaktorska
        </a>
    </li>
    <li class="manage-nav__item">
        <a class="manage-nav__link @ManageNavPages.PersonalDataNavClass(ViewContext)" asp-page="./PersonalData">
            <i class="fa-solid fa-database"></i> Osobni podaci
        </a>
    </li>
</ul>

