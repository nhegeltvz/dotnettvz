@model List<Data.Models.MatchPlayer>

<div class="dashboard-panel-header">
    <h2 class="dashboard-panel-title">Match Players</h2>
    <a class="dashboard-action-button" href="#" data-dashboard-action="/match-players/create" aria-label="Add match player">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
    </a>
</div>

<table class="dashboard-table" aria-label="Match players list">
    <thead>
        <tr>
            <th>ID</th>
            <th>Team</th>
            <th>Goals</th>
            <th>Assists</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mp in Model)
        {
            <tr>
                <td>@mp.Id</td>
                <td>@mp.Team</td>
                <td>@mp.Goals</td>
                <td>@mp.Assists</td>
                <td>
                    <div class="dashboard-table-actions">
                        <a class="dashboard-row-button" href="#" data-dashboard-action="/match-players/edit/@mp.Id" aria-label="Edit match player">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                        </a>
                        <form asp-controller="MatchPlayers" asp-action="Delete" asp-route-id="@mp.Id" method="post" data-dashboard-delete>
                            <button class="dashboard-row-button dashboard-row-button--danger" type="submit" aria-label="Delete match player">X</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
