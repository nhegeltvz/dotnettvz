@{
    ViewData["Title"] = "Dashboard - Players";
}

<section class="dashboard-panel">
    <button type="button" class="dashboard-add-button" onclick="openCreate()">+ Add Player</button>
    <header class="dashboard-panel-header">
        <h2 class="dashboard-panel-title">Players</h2>
    </header>
    <div style="display:flex;justify-content:center;">
        <table class="dashboard-table" aria-label="Players table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="playerTable">
                <!-- Ajax: inject player rows here -->
            </tbody>
        </table>
    </div>
</section>

<div id="form-container"></div>

@section Scripts {
    <script>
        const tableBody = document.getElementById("playerTable");
        document.addEventListener("DOMContentLoaded", async () => {
            await loadPlayers();
        })

        function loadPlayers(){
                    $.ajax({
            url: "/players/data",
            method: "GET",
            success: function(players) {
                console.log(players);
                let injectedHtml = "";
                players.forEach(player => {
                    injectedHtml +=
                    `
                    <tr>
                        <td>${player.username}</td>
                        <td>${player.email}</td>
                        <td>
                            <button class="dashboard-row-button dashboard-row-button--danger" onclick="deletePlayer('${player.id}')">Delete</button>
                        </td>
                    </tr>
                    `
                });
                tableBody.innerHTML=injectedHtml;
            }
        });
        }

        function openCreate() {
            $.get("/players/form", function(html) {
                $("#form-container").html(html);
                $("#player-id").val("");
                $.validator.unobtrusive.parse("#player-form");
            });
        }

                function cancelForm() {
            $("#form-container").html("");
        }

        function submitForm() {
            const id = $("#player-id").val();
            const url = id ? `/players/edit/${id}` : "/players/create";
            const method = id ? "PUT" : "POST";

            if (!$("#player-form").valid()) return;

        $.ajax({
            url: url,
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify({
                username: $("#Username").val(),
                email: $("#Email").val(),
                bio: $("#Bio").val(),
                age: $("#Age").val(),
                preferredPosition: $("#PreferredPosition").val()
            }),
            success: function() {
                cancelForm();
                loadPlayers();
            },
            error: function(xhr) {
                console.log(xhr.responseJSON);
            }
        });
        }

                function deletePlayer(id) {
            if (!confirm("Are you sure?")) return;

            $.ajax({
                url: `/players/delete/${id}`,
                method: "DELETE",
                success: function() {
                    loadPlayers();
                },
                error: function(xhr) {
                    console.log(xhr.responseJSON);
                }
            });
        }

    </script>
}