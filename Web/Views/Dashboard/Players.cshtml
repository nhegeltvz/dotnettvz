@using Web.Models.Dashboard
@{
    ViewData["Title"] = "Dashboard - Players";
    var autocompleteConfig = new AutocompleteConfig()
    {
        Label = "Search Players",
        Placeholder = "ex. Ronaldo Nazario",
        InputId = "playerSearch",
        SearchUrl = "/players/data",
        ListUrl = "/players/data",
        LabelField = "username"
    };
}
<div class="dashboard-toast"></div>
<div class="dashboard-toolbar">
    <div class="dashboard-search-wrapper">
        <partial name="_AutocompleteSearch" model="autocompleteConfig" />
    </div>
    <button type="button" class="dashboard-add-button" onclick="openCreate()">+ Add Player</button>
</div>
<section class="dashboard-panel">
    <header class="dashboard-panel-header">
        <h2 class="dashboard-panel-title">Players</h2>
    </header>
    <div style="display:flex;justify-content:center;">
        <table class="dashboard-table" aria-label="Players table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="playerTable">
                <!-- Ajax: inject player rows here -->
            </tbody>
        </table>
    </div>
</section>

<div id="form-container"></div>

@section Scripts {
    <script src="~/js/players.js"></script>
}