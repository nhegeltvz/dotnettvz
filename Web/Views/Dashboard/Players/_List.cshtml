@model List<Data.Models.Player>
@using Web.Models.Dashboard

@await Html.PartialAsync("~/Views/Dashboard/Shared/_AutocompleteSearch.cshtml", new AutocompleteConfig
{
    Label = "Search players",
    Placeholder = "Type a player username...",
    InputId = "playerSearch",
    SearchUrl = "/players/search",
    ListUrl = "/players/list"
})

<div class="dashboard-panel-header">
    <h2 class="dashboard-panel-title">Players</h2>
    <a class="dashboard-action-button" href="#" data-dashboard-action="/players/create" aria-label="Add player">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
    </a>
</div>

<table class="dashboard-table" aria-label="Players list">
    <thead>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var player in Model)
        {
            <tr>
                <td>@player.Id</td>
                <td>@player.Username</td>
                <td>@player.Email</td>
                <td>
                    <div class="dashboard-table-actions">
                        <a class="dashboard-row-button" href="#" data-dashboard-action="/players/edit/@player.Id" aria-label="Edit player">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                        </a>
                        <form asp-controller="Players" asp-action="Delete" asp-route-id="@player.Id" method="post" data-dashboard-delete>
                            <button class="dashboard-row-button dashboard-row-button--danger" type="submit" aria-label="Delete player">
                                X
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
