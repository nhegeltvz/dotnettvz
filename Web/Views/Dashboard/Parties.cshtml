@using Web.Models.Dashboard
@{
    ViewData["Title"] = "Dashboard - Parties";
    var autocompleteConfig = new AutocompleteConfig()
    {
        Label = "Pretraži grupe",
        Placeholder = "npr. Večernji kickoff",
        InputId = "partySearch",
        SearchUrl = "/parties/data",
        ListUrl = "/parties/data",
        LabelField = "partyDescription"
    };
}

<div class="dashboard-toast"></div>
<div class="dashboard-toolbar">
    <div class="dashboard-search-wrapper">
        <partial name="_AutocompleteSearch" model="autocompleteConfig" />
    </div>
    <button type="button" class="dashboard-add-button" onclick="openCreate()">+ Dodaj grupu</button>
</div>

<section class="dashboard-panel">
    <header class="dashboard-panel-header">
        <h2 class="dashboard-panel-title">Grupe</h2>
    </header>
    <div style="display:flex;justify-content:center;">
        <table class="dashboard-table" aria-label="Parties table">
            <thead>
                <tr>
                    <th>Vlasnik</th>
                    <th>Datum</th>
                    <th>Opis</th>
                    <th>Članovi</th>
					<th>Akcija</th>
                </tr>
            </thead>
            <tbody id="partiesTable">
                <!-- Ajax: inject party rows here -->
            </tbody>
        </table>
    </div>
</section>

<div id="form-container"></div>

@section Scripts {
    <script src="~/js/parties.js"></script>
}