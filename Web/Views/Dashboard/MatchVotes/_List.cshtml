@model List<Data.Models.MatchVote>

<div class="dashboard-panel-header">
    <h2 class="dashboard-panel-title">Match Votes</h2>
    <a class="dashboard-action-button" href="#" data-dashboard-action="/match-votes/create" aria-label="Add match vote">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
    </a>
</div>

<table class="dashboard-table" aria-label="Match votes list">
    <thead>
        <tr>
            <th>ID</th>
            <th>Voted Held</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var vote in Model)
        {
            <tr>
                <td>@vote.Id</td>
                <td>@vote.VotedHeld</td>
                <td>
                    <div class="dashboard-table-actions">
                        <a class="dashboard-row-button" href="#" data-dashboard-action="/match-votes/edit/@vote.Id" aria-label="Edit match vote">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                        </a>
                        <form asp-controller="MatchVotes" asp-action="Delete" asp-route-id="@vote.Id" method="post" data-dashboard-delete>
                            <button class="dashboard-row-button dashboard-row-button--danger" type="submit" aria-label="Delete match vote">X</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
