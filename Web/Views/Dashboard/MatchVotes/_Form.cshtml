@model Data.Dto.CRUD.MatchVote.MatchVoteFormDto

<div class="dashboard-panel-header">
    <h2 class="dashboard-panel-title">@(Model.Id.HasValue ? "Edit Match Vote" : "Create Match Vote")</h2>
</div>

<form class="dashboard-form" asp-controller="MatchVotes" asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" data-dashboard-form>
    @if (Model.Id.HasValue)
    {
        <input type="hidden" name="Id" value="@Model.Id" />
    }

    <div class="dashboard-form-row">
        <label asp-for="VotedHeld"></label>
        <input asp-for="VotedHeld" type="checkbox" />
        <span asp-validation-for="VotedHeld" class="text-danger"></span>
    </div>

    <div class="dashboard-form-actions">
        <button class="dashboard-submit" type="submit">Save changes</button>
    </div>
</form>
