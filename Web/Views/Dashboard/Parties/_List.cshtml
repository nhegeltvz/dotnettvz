@model List<Data.Models.Party>

<div class="dashboard-panel-header">
    <h2 class="dashboard-panel-title">Parties</h2>
    <a class="dashboard-action-button" href="#" data-dashboard-action="/parties/create" aria-label="Add party">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
    </a>
</div>

<table class="dashboard-table" aria-label="Parties list">
    <thead>
        <tr>
            <th>ID</th>
            <th>Created</th>
            <th>Max Members</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var party in Model)
        {
            <tr>
                <td>@party.Id</td>
                <td>@party.DateCreated.ToString("yyyy-MM-dd")</td>
                <td>@party.MaxMembers</td>
                <td>
                    <div class="dashboard-table-actions">
                        <a class="dashboard-row-button" href="#" data-dashboard-action="/parties/edit/@party.Id" aria-label="Edit party">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                        </a>
                        <form asp-controller="Parties" asp-action="Delete" asp-route-id="@party.Id" method="post" data-dashboard-delete>
                            <button class="dashboard-row-button dashboard-row-button--danger" type="submit" aria-label="Delete party">X</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
