@model Data.Dto.CRUD.Party.PartyFormDto

<div class="dashboard-panel-header">
    <h2 class="dashboard-panel-title">@(Model.Id.HasValue ? "Edit Party" : "Create Party")</h2>
</div>

<form class="dashboard-form" asp-controller="Parties" asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" data-dashboard-form>
    @if (Model.Id.HasValue)
    {
        <input type="hidden" name="Id" value="@Model.Id" />
    }

    <div class="dashboard-form-row">
        <label asp-for="MaxMembers"></label>
        <input asp-for="MaxMembers" type="number" min="2" max="20" />
        <span asp-validation-for="MaxMembers" class="text-danger"></span>
    </div>

    <div class="dashboard-form-row">
        <label asp-for="PartyDescription"></label>
        <textarea asp-for="PartyDescription" rows="3"></textarea>
        <span asp-validation-for="PartyDescription" class="text-danger"></span>
    </div>

    <div class="dashboard-form-row">
        <label asp-for="PreferredLocations"></label>
        <textarea asp-for="PreferredLocations" rows="2"></textarea>
        <span asp-validation-for="PreferredLocations" class="text-danger"></span>
    </div>

    <div class="dashboard-form-actions">
        <button class="dashboard-submit" type="submit">Save changes</button>
    </div>
</form>
