@using Web.Models.Dashboard
@{
	ViewData["Title"] = "Dashboard - Playing Fields";
	var autocompleteConfig = new AutocompleteConfig()
	{
		Label = "Search Playing Fields",
		Placeholder = "ex. City Arena",
		InputId = "stadiumSearch",
		SearchUrl = "/api/playing-fields",
		ListUrl = "/api/playing-fields",
		LabelField = "name"
	};
}

<div class="dashboard-toast"></div>
<div class="dashboard-toolbar">
    <div class="dashboard-search-wrapper">
	    <partial name="_AutocompleteSearch" model="autocompleteConfig" />
    </div>
    <button type="button" class="dashboard-add-button" onclick="openCreate()">+ Add Playing Field</button>
</div>

<section class="dashboard-panel">
	<header class="dashboard-panel-header">
		<h2 class="dashboard-panel-title">Playing Fields</h2>
	</header>
	<div style="display:flex;justify-content:center;">
		<table class="dashboard-table" aria-label="Playing fields table">
			<thead>
				<tr>
					<th>Name</th>
					<th>Surface</th>
					<th>Location</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody id="playingFieldTable">
				<!-- Ajax: inject playing field rows here -->
			</tbody>
		</table>
	</div>
</section>

<div id="form-container"></div>


@section Scripts {
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.min.css" />
	<script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.min.js"></script>
	<script>Dropzone.autoDiscover = false;</script>
	<script src="~/js/playingFields.js" asp-append-version="true"></script>
}