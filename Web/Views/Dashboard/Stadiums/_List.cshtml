@model List<Data.Models.PlayingField>
@using Web.Models.Dashboard

@await Html.PartialAsync("~/Views/Dashboard/Shared/_AutocompleteSearch.cshtml", new AutocompleteConfig
{
    Label = "Search stadiums",
    Placeholder = "Type a stadium name...",
    InputId = "stadiumSearch",
    SearchUrl = "/stadiums/search",
    ListUrl = "/stadiums/list"
})

<div class="dashboard-panel-header">
    <h2 class="dashboard-panel-title">Stadiums</h2>
    <a class="dashboard-action-button" href="#" data-dashboard-action="/stadiums/create" aria-label="Add stadium">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
    </a>
</div>

<table class="dashboard-table" aria-label="Stadiums list">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var field in Model)
        {
            <tr>
                <td>@field.Id</td>
                <td>@field.Name</td>
                <td>@field.Status</td>
                <td>
                    <div class="dashboard-table-actions">
                        <a class="dashboard-row-button" href="#" data-dashboard-action="/stadiums/edit/@field.Id" aria-label="Edit stadium">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                        </a>
                        <form asp-controller="Stadiums" asp-action="Delete" asp-route-id="@field.Id" method="post" data-dashboard-delete>
                            <button class="dashboard-row-button dashboard-row-button--danger" type="submit" aria-label="Delete stadium">
                                X
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
