@model List<Data.Models.ScheduledMatch>

<div class="dashboard-panel-header">
    <h2 class="dashboard-panel-title">Scheduled Matches</h2>
    <a class="dashboard-action-button" href="#" data-dashboard-action="/scheduled-matches/create" aria-label="Add scheduled match">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
    </a>
</div>

<table class="dashboard-table" aria-label="Scheduled matches list">
    <thead>
        <tr>
            <th>ID</th>
            <th>Match Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var match in Model)
        {
            <tr>
                <td>@match.Id</td>
                <td>@match.MatchDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <div class="dashboard-table-actions">
                        <a class="dashboard-row-button" href="#" data-dashboard-action="/scheduled-matches/edit/@match.Id" aria-label="Edit scheduled match">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                        </a>
                        <form asp-controller="ScheduledMatches" asp-action="Delete" asp-route-id="@match.Id" method="post" data-dashboard-delete>
                            <button class="dashboard-row-button dashboard-row-button--danger" type="submit" aria-label="Delete scheduled match">X</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
