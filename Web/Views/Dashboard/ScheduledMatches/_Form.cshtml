@model Data.Dto.CRUD.ScheduledMatch.ScheduledMatchFormDto

<div class="dashboard-panel-header">
    <h2 class="dashboard-panel-title">@(Model.Id.HasValue ? "Edit Scheduled Match" : "Create Scheduled Match")</h2>
</div>

<form class="dashboard-form" asp-controller="ScheduledMatches" asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" data-dashboard-form>
    @if (Model.Id.HasValue)
    {
        <input type="hidden" name="Id" value="@Model.Id" />
    }

    <div class="dashboard-form-row">
        <label asp-for="MatchDate"></label>
        <input asp-for="MatchDate" type="datetime-local" />
        <span asp-validation-for="MatchDate" class="text-danger"></span>
    </div>

    <div class="dashboard-form-actions">
        <button class="dashboard-submit" type="submit">Save changes</button>
    </div>
</form>
