@using Web.Models.Dashboard
@{
    ViewData["Title"] = "Dashboard - Match Records";
    var autocompleteConfig = new AutocompleteConfig()
    {
        Label = "Pretraži utakmice",
        Placeholder = "npr. Maksimir",
        InputId = "matchRecordSearch",
        SearchUrl = "/matches/data",
        ListUrl = "/matches/data",
        LabelField = "playingFieldName"
    };
}

<div class="dashboard-toast"></div>
<div class="dashboard-toolbar">
    <div class="dashboard-search-wrapper">
        <partial name="_AutocompleteSearch" model="autocompleteConfig" />
    </div>
    <button type="button" class="dashboard-add-button" onclick="openCreate()">+ Dodaj utakmicu</button>
</div>

<section class="dashboard-panel">
    <header class="dashboard-panel-header">
        <h2 class="dashboard-panel-title">Utakmice</h2>
    </header>
    <div style="display:flex;justify-content:center;">
        <table class="dashboard-table" aria-label="Match records table">
            <thead>
                <tr>
                    <th>A vs B</th>
                    <th>Datum</th>
                    <th>Odigrana</th>
                    <th>Akcija</th>
                </tr>
            </thead>
            <tbody id="matchRecordsTable">
                <!-- Ajax: inject match record rows here -->
            </tbody>
        </table>
    </div>
</section>

<div id="form-container"></div>

@section Scripts {
    <script src="~/js/matchRecords.js"></script>
}