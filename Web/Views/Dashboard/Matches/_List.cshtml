@model List<Data.Models.MatchRecord>

<div class="dashboard-panel-header">
    <h2 class="dashboard-panel-title">Match Records</h2>
    <a class="dashboard-action-button" href="#" data-dashboard-action="/matches/create" aria-label="Add match record">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
    </a>
</div>

<table class="dashboard-table" aria-label="Match records list">
    <thead>
        <tr>
            <th>ID</th>
            <th>Date</th>
            <th>Held</th>
            <th>Team A</th>
            <th>Team B</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var record in Model)
        {
            <tr>
                <td>@record.Id</td>
                <td>@record.MatchHeld.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@record.WasMatchHeld</td>
                <td>@record.GoalsTeamA</td>
                <td>@record.GoalsTeamB</td>
                <td>
                    <div class="dashboard-table-actions">
                        <a class="dashboard-row-button" href="#" data-dashboard-action="/matches/edit/@record.Id" aria-label="Edit match record">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                        </a>
                        <form asp-controller="Matches" asp-action="Delete" asp-route-id="@record.Id" method="post" data-dashboard-delete>
                            <button class="dashboard-row-button dashboard-row-button--danger" type="submit" aria-label="Delete match record">X</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
