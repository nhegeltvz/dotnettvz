@model Data.Dto.CRUD.MatchRecord.MatchRecordFormDto

<div class="dashboard-panel-header">
    <h2 class="dashboard-panel-title">@(Model.Id.HasValue ? "Edit Match Record" : "Create Match Record")</h2>
</div>

<form class="dashboard-form" asp-controller="Matches" asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" data-dashboard-form>
    @if (Model.Id.HasValue)
    {
        <input type="hidden" name="Id" value="@Model.Id" />
    }

    <div class="dashboard-form-row">
        <label asp-for="WasMatchHeld"></label>
        <input asp-for="WasMatchHeld" type="checkbox" />
        <span asp-validation-for="WasMatchHeld" class="text-danger"></span>
    </div>

    <div class="dashboard-form-row">
        <label asp-for="MatchHeld"></label>
        @await Html.PartialAsync("~/Views/Shared/_CustomDatePicker.cshtml",
        new CustomDatePickerModel
        {
            FieldName = "MatchHeld",
            Value = Model.MatchHeld != default
        ? Model.MatchHeld.ToString("yyyy-MM-ddTHH:mm")
        : null
        })
        <span asp-validation-for="MatchHeld" class="text-danger"></span>
    </div>

    <div class="dashboard-form-row">
        <label asp-for="GoalsTeamA"></label>
        <input asp-for="GoalsTeamA" type="number" min="0" max="100" />
        <span asp-validation-for="GoalsTeamA" class="text-danger"></span>
    </div>

    <div class="dashboard-form-row">
        <label asp-for="GoalsTeamB"></label>
        <input asp-for="GoalsTeamB" type="number" min="0" max="100" />
        <span asp-validation-for="GoalsTeamB" class="text-danger"></span>
    </div>

    <div class="dashboard-form-actions">
        <button class="dashboard-submit" type="submit">Save changes</button>
    </div>
</form>
