@model Data.Dto.CRUD.PlayerRating.PlayerRatingFormDto

<div class="dashboard-panel-header">
    <h2 class="dashboard-panel-title">@(Model.Id.HasValue ? "Edit Player Rating" : "Create Player Rating")</h2>
</div>

<form class="dashboard-form" asp-controller="PlayerRatings" asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" data-dashboard-form>
    @if (Model.Id.HasValue)
    {
        <input type="hidden" name="Id" value="@Model.Id" />
    }

    <div class="dashboard-form-row">
        <label asp-for="Rating"></label>
        <input asp-for="Rating" type="number" min="1" max="10" />
        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>

    <div class="dashboard-form-actions">
        <button class="dashboard-submit" type="submit">Save changes</button>
    </div>
</form>
