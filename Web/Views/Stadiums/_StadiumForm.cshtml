@model Data.Dto.CRUD.PlayingField.StadiumFormDto
@using Data.Data

<section class="dashboard-panel">
    <header class="dashboard-panel-header">
        <h2 class="dashboard-panel-title">Playing Field</h2>
    </header>
    <form id="stadium-form" class="dashboard-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" id="stadium-id" />
        <div id="stadium-edit-banner" class="dashboard-edit-banner" hidden>Editing playing field</div>

        <div class="dashboard-form-row">
            <label asp-for="Name"></label>
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="dashboard-form-row">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="dashboard-form-row">
            <label asp-for="ContactNumber"></label>
            <input asp-for="ContactNumber" />
            <span asp-validation-for="ContactNumber" class="text-danger"></span>
        </div>

        <div class="dashboard-form-row">
            <label asp-for="Status"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<FieldStatus>()"></select>
        </div>

        <div class="dashboard-form-row">
            <label asp-for="SurfaceType"></label>
            <select asp-for="SurfaceType" asp-items="Html.GetEnumSelectList<SurfaceType>()"></select>
        </div>

        <div class="dashboard-form-row">
            <label asp-for="IsOutdoor"></label>
            <input asp-for="IsOutdoor" type="checkbox" />
        </div>

        <div class="dashboard-form-row">
            <label asp-for="Latitude"></label>
            <input asp-for="Latitude" />
            <span asp-validation-for="Latitude" class="text-danger"></span>
        </div>

        <div class="dashboard-form-row">
            <label asp-for="Longitude"></label>
            <input asp-for="Longitude" />
            <span asp-validation-for="Longitude" class="text-danger"></span>
        </div>

        <div class="dashboard-form-actions">
            <button type="button" class="dashboard-button-secondary" onclick="cancelForm()">Cancel</button>
            <button type="button" class="dashboard-submit" onclick="submitForm()">Save</button>
        </div>
    </form>
</section>
