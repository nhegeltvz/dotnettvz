@model List<Data.Models.Player>
@using Data.Data
@using Data.Models

@{
    ViewData["Title"] = "Players";
    ViewData["Breadcrumbs"] = new List<Web.Helpers.BreadcrumbItem>
    {
        new("Home", "/home"),
        new("Players")
    };

    List<Player> GetPositionedPlayers(Position prefferedPositon)
    => Model.Where(player => player.PreferredPosition == prefferedPositon).ToList();

    List<Player> GetFeaturedPlayers(List<Player> players, Func<Player,double> selector, int takeNumber)
    => players
        .OrderByDescending(selector)
        .ThenByDescending(player => player.MatchPlayers.Count)
        .Take(takeNumber).ToList();


    var goalkeepers = GetPositionedPlayers(Position.Goalkeeper);
    var defenders = GetPositionedPlayers(Position.Defender);
    var midfielders = GetPositionedPlayers(Position.Midfielder);
    var strikers = GetPositionedPlayers(Position.Forward);


    var featuredGoalkeepers = GetFeaturedPlayers(goalkeepers, player => player.RatingsReceived.Count == 0 ? 0: player.RatingsReceived.Average(rating => rating.Rating), 1);
    var featuredDefenders = GetFeaturedPlayers(defenders, player => player.RatingsReceived.Count == 0? 0: player.RatingsReceived.Average(rating => rating.Rating), 2);
    var featuredMidfielders = GetFeaturedPlayers(midfielders, player => player.MatchPlayers.Sum(match => match.Assists), 3);
    var featuredStrikers = GetFeaturedPlayers(strikers, player => player.MatchPlayers.Sum(match => match.Goals), 3);
}

<header class="players-stars-header" aria-label="Featured players section">
    <p class="players-stars-kicker">Monthly Spotlight</p>
    <h1 class="players-stars-title">Stars of the month</h1>
</header>

<div class="player-positions-grid">
    <div class="position-container strikers-container" data-jump-position="forward" role="button" tabindex="0" aria-label="Show forwards in player list">
        <img class="hero-image hero-square hero-strikers" src="~/images/budimirHero.png" alt="" />
        <div class="featured-panel featured-strikers">
            <span class="featured-title">Golgeteri</span>
            <div class="featured-cards">
                @foreach (var player in featuredStrikers)
                {
                    if(!string.IsNullOrEmpty(player.Username))
                    {
                        <partial name="_PlayerCard" model="player" />
                    }
                }
            </div>
        </div>
        <h2 class="position-title">Strikers</h2>
    </div>
    <div class="position-container midfielders-container" data-jump-position="midfielder" role="button" tabindex="0" aria-label="Show midfielders in player list">
        <img class="hero-image hero-portrait hero-midfielders" src="~/images/baturinaHero.png" alt="" />
        <div class="featured-panel featured-midfielders">
            <span class="featured-title">Playmakeri</span>
            <div class="featured-cards featured-cards--stacked">
                @foreach (var player in featuredMidfielders)
                {
                    <partial name="_PlayerCard" model="player" />
                }
            </div>
        </div>
        <h2 class="position-title">Midfielders</h2>

    </div>
    <div class="position-container defenders-container" data-jump-position="defender" role="button" tabindex="0" aria-label="Show defenders in player list">
        <img class="hero-image hero-square hero-defenders" src="~/images/vuskovicHero.png" alt="" />
        <div class="featured-panel featured-defenders">
            <span class="featured-title">Najpouzdaniji</span>
            <div class="featured-cards">
                @foreach (var player in featuredDefenders)
                {
                    <partial name="_PlayerCard" model="player" />
                }
            </div>
        </div>
        <h2 class="position-title">Centrebacks</h2>
    </div>
    <div class="position-container goalkeepers-container" data-jump-position="goalkeeper" role="button" tabindex="0" aria-label="Show goalkeepers in player list">
        <img class="hero-image hero-square hero-goalkeepers" src="~/images/livakovicHero.png" alt="" />
        <div class="featured-panel featured-goalkeepers">
            <span class="featured-title">Zidari mreze</span>
            <div class="featured-cards">
                @foreach (var player in featuredGoalkeepers)
                {
                    <partial name="_PlayerCard" model="player" />
                }
            </div>
        </div>
        <h2 class="position-title">Vratari</h2>
    </div>
</div>

<div class="players-list-container">
    <h3 class="players-list-title">Svi igrači</h3>

    <div class="players-filters" aria-label="Filter players">
        <div class="players-position-filters" role="group" aria-label="Filter by position">
            <button type="button" class="players-filter-button is-active" data-position="all">Svi</button>
            <button type="button" class="players-filter-button" data-position="goalkeeper">Vratari</button>
            <button type="button" class="players-filter-button" data-position="defender">Defenderi</button>
            <button type="button" class="players-filter-button" data-position="midfielder">Vezni</button>
            <button type="button" class="players-filter-button" data-position="forward">Napadaci</button>
        </div>

        <div class="players-search-wrap">
            <label for="playersSearch" class="players-search-label">Trazi po username-u</label>
            <input
                id="playersSearch"
                class="players-search-input"
                type="search"
                placeholder="Upisi username..."
                autocomplete="off" />
        </div>
    </div>

    <div class="player-list">
        @foreach (var player in Model)
        {
            var matches = player.MatchPlayers.Count;
            var goals = player.MatchPlayers.Sum(match => match.Goals);
            var assists = player.MatchPlayers.Sum(match => match.Assists);
            var avgRating = player.RatingsReceived.Count == 0
                ? 0
                : player.RatingsReceived.Average(rating => rating.Rating);
            var ageLabel = player.Age.HasValue ? player.Age.Value.ToString() : "-";

            <a
                class="player-list-link"
                asp-controller="Players"
                asp-action="Details"
                asp-route-id="@player.Id">
                <article
                    class="player-list-row"
                    data-position="@player.PreferredPosition.ToString().ToLowerInvariant()"
                    data-username="@player.Username.ToLowerInvariant()">
                    <div class="player-list-main">
                            <div class="player-row-avatar" aria-hidden="true">@DataUtility.GetInitials(player.Username, "P")</div>

                        <div class="player-row-identity">
                            <span class="player-row-username">@player.Username</span>
                            <span class="player-row-meta">@player.PreferredPosition • @ageLabel god</span>
                        </div>
                    </div>

                    <div class="player-row-stats" aria-label="Player stats">
                        <span class="player-row-pill">M @matches</span>
                        <span class="player-row-pill">G @goals</span>
                        <span class="player-row-pill">A @assists</span>
                        <span class="player-row-pill">R @avgRating.ToString("0.0")</span>
                    </div>
                </article>
            </a>
        }
    </div>

    <p id="playersNoResults" class="players-no-results" hidden>Nema igraca za odabrani filter.</p>
</div>

@section Scripts {
    <script>
        (function () {
            const listRows = Array.from(document.querySelectorAll('.player-list-row'));
            const filterButtons = Array.from(document.querySelectorAll('.players-filter-button'));
            const featuredContainers = Array.from(document.querySelectorAll('.position-container[data-jump-position]'));
            const searchInput = document.getElementById('playersSearch');
            const noResults = document.getElementById('playersNoResults');
            const listContainer = document.querySelector('.players-list-container');

            let activePosition = 'all';

            function applyFilters() {
                const usernameFilter = (searchInput?.value || '').trim().toLowerCase();
                let visibleCount = 0;

                listRows.forEach((row) => {
                    const rowPosition = row.dataset.position || '';
                    const rowUsername = row.dataset.username || '';

                    const matchesPosition = activePosition === 'all' || rowPosition === activePosition;
                    const matchesUsername = usernameFilter.length === 0 || rowUsername.includes(usernameFilter);

                    const shouldShow = matchesPosition && matchesUsername;
                    row.parentElement.hidden = !shouldShow;

                    if (shouldShow) {
                        visibleCount += 1;
                    }
                });

                noResults.hidden = visibleCount > 0;
            }

            function activatePositionFilter(position) {
                activePosition = position;

                filterButtons.forEach((button) => {
                    const isActive = (button.dataset.position || 'all') === position;
                    button.classList.toggle('is-active', isActive);
                });

                applyFilters();
            }

            filterButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    activatePositionFilter(button.dataset.position || 'all');
                });
            });

            featuredContainers.forEach((container) => {
                const jump = () => {
                    const selectedPosition = container.dataset.jumpPosition || 'all';

                    activatePositionFilter(selectedPosition);

                    if (listContainer) {
                        listContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                };

                container.addEventListener('click', jump);
                container.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        jump();
                    }
                });
            });

            searchInput?.addEventListener('input', applyFilters);

            applyFilters();
        })();
    </script>
}