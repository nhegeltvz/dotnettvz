@using Data.Data
@using Web.Models
@using Web.Models.Dashboard
@model PlayerFormViewModel

<section class="dashboard-panel">
    <header class="dashboard-panel-header">
        <h2 class="dashboard-panel-title">Player Details</h2>
    </header>
    <form id="player-form" class="dashboard-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" id="player-id" />
        <div id="player-edit-banner" class="dashboard-edit-banner" hidden>Editing player</div>

        <div class="dashboard-form-row">
            <label asp-for="Form.UserId">User</label>
            <select asp-for="Form.UserId" asp-items="Model.Users">
                <option value="">-- Select user --</option>
            </select>
            <span asp-validation-for="Form.UserId" class="text-danger"></span>
        </div>

        <div class="dashboard-form-row">
            <label asp-for="Form.Bio"></label>
            <textarea asp-for="Form.Bio"></textarea>
            <span asp-validation-for="Form.Bio" class="text-danger"></span>
        </div>

        <div class="dashboard-form-row">
            <label asp-for="Form.DateOfBirth"></label>
            @await Html.PartialAsync("_CustomDatePicker", new CustomDatePickerModel
            {
                FieldName = "Form_DateOfBirth",
                EnableTime = false,
                Value = Model.Form.DateOfBirth != default
                    ? Model.Form.DateOfBirth.ToString("yyyy-MM-dd")
                    : null,
            })
            <span asp-validation-for="Form.DateOfBirth" class="text-danger"></span>
        </div>

        <div class="dashboard-form-row">
            <label asp-for="Form.PreferredPosition"></label>
            <select asp-for="Form.PreferredPosition" asp-items="Html.GetEnumSelectList<Position>()"></select>
            <span asp-validation-for="Form.PreferredPosition" class="text-danger"></span>
        </div>

        <div class="dashboard-form-actions">
            <button type="button" class="dashboard-button-secondary" onclick="cancelForm()">Cancel</button>
            <button type="button" class="dashboard-submit" onclick="submitForm()">Save</button>
        </div>
    </form>
</section>
