@model Data.Models.Player
@using Data.Services

@{
    ViewData["Title"] = "Detalji igraca";
    ViewData["Breadcrumbs"] = new List<Web.Helpers.BreadcrumbItem>
    {
        new("Početna", "/home"),
        new("Igrači", "/Players"),
        new("Detalji igrača")
    };

    var matches = Model.MatchPlayers.Count;
    var goals = Model.MatchPlayers.Sum(match => match.Goals);
    var assists = Model.MatchPlayers.Sum(match => match.Assists);
    var averageRating = Model.RatingsReceived.Count == 0
        ? 0
        : Model.RatingsReceived.Average(rating => rating.Rating);
    var age = Model.DateOfBirth != default
        ? (DateTime.Today.Year - Model.DateOfBirth.Year).ToString()
        : "-";
}

<div class="player-details-page">
    <a asp-controller="Players" asp-action="Index" class="player-details-back">
        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        Natrag na igrace
    </a>

    <article class="player-details-card">
        <div class="player-details-header">
            <div class="player-details-avatar" aria-hidden="true">@DataUtility.GetInitials(Model.User?.UserName, "P")</div>

            <div class="player-details-identity">
                <h1>@Model.User?.UserName</h1>
                <p>@Localization.Localize(Model.PreferredPosition) • @age god</p>
            </div>
        </div>

        <section class="player-details-stats-grid" aria-label="Player statistics">
            <div class="player-details-stat">
                <span class="player-details-stat-label">Utakmice</span>
                <span class="player-details-stat-value">@matches</span>
            </div>
            <div class="player-details-stat">
                <span class="player-details-stat-label">Golovi</span>
                <span class="player-details-stat-value">@goals</span>
            </div>
            <div class="player-details-stat">
                <span class="player-details-stat-label">Asistencije</span>
                <span class="player-details-stat-value">@assists</span>
            </div>
            <div class="player-details-stat">
                <span class="player-details-stat-label">Prosjecna ocjena</span>
                <span class="player-details-stat-value">@averageRating.ToString("0.0")</span>
            </div>
        </section>

        <section class="player-details-section">
            <h2>Bio</h2>
            <p>@(string.IsNullOrWhiteSpace(Model.Bio) ? "Nema opisa." : Model.Bio)</p>
        </section>

        <section class="player-details-section">
            <h2>Kontakt</h2>
            <p>@Model.User?.Email</p>
        </section>
    </article>
</div>
