<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/all.min.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Oswald:wght@400;600&family=Roboto:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="top-header">
        <div class="header-side header-left">
            <a class="brand-link" asp-area="" asp-controller="Home" asp-action="Index">MatchTracker</a>
        </div>
        <nav class="header-center" aria-label="Main navigation">
            <a class="header-link @Html.IsActive("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            <a class="header-link @Html.IsActive("Parties", "Index")" asp-area="" asp-controller="Parties" asp-action="Index">Parties</a>
            <a class="header-link @Html.IsActive("Stadiums", "Index")" asp-area="" asp-controller="Stadiums" asp-action="Index">Stadiums</a>
            <a class="header-link @Html.IsActive("Matches", "Index")" asp-area="" asp-controller="Matches" asp-action="Index">Matches</a>
            <a class="header-link @Html.IsActive("Players", "Index")" asp-area="" asp-controller="Players" asp-action="Index">Players</a>
        </nav>
        <div class="header-side header-right">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="user-profile-icon">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
        </div>
    </header>
    @await Html.PartialAsync("_Breadcrumbs")
    <main role="main" class="main-content">
            @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
