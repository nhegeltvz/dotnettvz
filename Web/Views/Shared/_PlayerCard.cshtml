@model Data.Models.Player
@using Data.Services

@{
    var matches  = Model.MatchPlayers.Count;
    var goals    = Model.MatchPlayers.Sum(m => m.Goals);
    var assists  = Model.MatchPlayers.Sum(m => m.Assists);
    var username = Model.User?.UserName ?? string.Empty;
    var age = Model.DateOfBirth != default
        ? (DateTime.Today.Year - Model.DateOfBirth.Year).ToString()
        : "-";
    var initials = string.IsNullOrWhiteSpace(username)
        ? "P"
        : string.Join(string.Empty,
            username.Split(['_', '-', '.'], StringSplitOptions.RemoveEmptyEntries)
                    .Select(part => char.ToUpperInvariant(part[0])));
}

<article class="player-card-lite">
    <div class="player-card-lite__avatar" aria-hidden="true">@initials</div>
    <div class="player-card-lite__header">
        <span class="player-card-lite__name">@username</span>
        <span class="player-card-lite__meta">@Localization.Localize(Model.PreferredPosition) • @age</span>
    </div>
    <div class="player-card-lite__stats">
        <span class="player-card-lite__stat">G @goals</span>
        <span class="player-card-lite__stat">A @assists</span>
        <span class="player-card-lite__stat">M @matches</span>
    </div>
</article>
