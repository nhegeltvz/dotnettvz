<div class="global-search" data-global-search-root>
    <div class="global-search__input-wrap">
        <i class="fa-solid fa-magnifying-glass global-search__icon"></i>
        <input class="global-search__input"
               id="globalSearchInput"
               type="search"
               placeholder="Pretraži igrače, terene, grupe..."
               autocomplete="off" />
        <button type="button" class="global-search__clear" aria-label="Clear search">Clear</button>
    </div>
    <div class="global-search__results" role="listbox" hidden></div>
</div>
