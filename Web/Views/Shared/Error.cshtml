@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Greška.</h1>
<h2 class="text-danger">Došlo je do pogreške pri obradi zahtjeva.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID zahtjeva:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Razvojni način rada</h3>
<p>
    Prebacivanje na <strong>Development</strong> okruženje prikazat će detaljnije informacije o nastaloj pogrešci.
</p>
<p>
    <strong>Development okruženje ne bi smjelo biti omogućeno za produkcijske aplikacije.</strong>
    Može rezultirati prikazivanjem osjetljivih informacija krajnjim korisnicima.
    Za lokalno testiranje, uključite <strong>Development</strong> okruženje postavljanjem varijable <strong>ASPNETCORE_ENVIRONMENT</strong> na <strong>Development</strong>
    i ponovnim pokretanjem aplikacije.
</p>
