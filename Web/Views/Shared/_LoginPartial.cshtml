@using Microsoft.AspNetCore.Identity

@inject SignInManager<Data.Models.AppUser> SignInManager
@inject UserManager<Data.Models.AppUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item user-menu-wrapper">
        <a class="user-menu-icon" asp-controller="UserDashboard" asp-action="Index" title="Profil">
            <i class="fa-solid fa-user"></i>
            <span class="user-menu-username">@UserManager.GetUserName(User)</span>
        </a>
        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" class="user-menu-logout">
            <button type="submit" class="user-logout-btn user-logout-btn--danger" title="Odjava">
                <i class="fa-solid fa-sign-out-alt"></i>
                <span>Odjava</span>
            </button>
        </form>
    </li>
}
else
{

        <li class="nav-item">

            <a class="nav-link text-dark" id="login" asp-area="Identity" asp-page="/Account/Login">
                <button class="mt--btn-ghost">
                    Prijava
                </button>
            </a>
            
        </li>
    <li class="nav-item">
        <a class="nav-link text-dark" id="register" asp-area="Identity" asp-page="/Account/Register">
            <button class="mt--btn-primary">
                Registracija
            </button>
        </a>
    </li>

}
</ul>
