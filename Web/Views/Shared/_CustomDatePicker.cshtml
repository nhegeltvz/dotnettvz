@model CustomDatePickerModel

<div class="date-picker-wrapper">
     <input type="text"
         class="date-picker-input"
         data-custom-date-picker
         data-field-name="@Model.FieldName"
         data-enable-time="@Model.EnableTime.ToString().ToLower()"
         placeholder=""
         readonly />
    <i class="fa-regular fa-calendar date-picker-icon" aria-hidden="true"></i>
    <input type="hidden"
        id="@Model.FieldName"
        name="@Model.FieldName"
        value="@Model.Value" />
</div>