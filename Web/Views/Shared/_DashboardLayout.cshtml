@{
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
}

<nav class="dashboard-subnav" aria-label="Dashboard navigation">
    <a class="dashboard-subnav-link @Html.IsActive("Dashboard", "PlayingFields")" asp-controller="Dashboard" asp-action="PlayingFields">
        <i class="fa-solid fa-flag-checkered"></i>
        <span>Playing Fields</span>
    </a>
    <a class="dashboard-subnav-link @Html.IsActive("Dashboard", "Players")" asp-controller="Dashboard" asp-action="Players">
        <i class="fa-solid fa-users"></i>
        <span>Players</span>
    </a>
    <a class="dashboard-subnav-link @Html.IsActive("Dashboard", "Parties")" asp-controller="Dashboard" asp-action="Parties">
        <i class="fa-regular fa-comments"></i>
        <span>Parties</span>
    </a>
    <a class="dashboard-subnav-link @Html.IsActive("Dashboard", "MatchRecords")" asp-controller="Dashboard" asp-action="MatchRecords">
        <i class="fa-solid fa-square-poll-horizontal"></i>
        <span>Match Records</span>
    </a>
    <a class="dashboard-subnav-link @Html.IsActive("Dashboard", "Logs")" asp-controller="Dashboard" asp-action="Logs">
        <i class="fa-solid fa-scroll"></i>
        <span>Logs</span>
    </a>
    <partial name="_LoadingSpinner"></partial>
</nav>
<div class="dashboard-main-content">
    @RenderBody()
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"></partial>
    @RenderSection("Scripts", required: false)
}
