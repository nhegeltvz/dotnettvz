@model Data.Models.PlayingField
@using Data.Services

<div class="stadium-card">
    <div class="stadium-image-container">
        @{
            var firstImage = Model.Images?.FirstOrDefault();
        }
        @if (firstImage != null)
        {
            <img src="@firstImage.Path" alt="@Model.Name" class="stadium-image" />
        }
        else
        {
            <div class="stadium-image-placeholder"></div>
        }
    </div>
    <div class="stadium-info">
        <h3 class="stadium-name">@Model.Name</h3>
        <div class="stadium-details">
            <span class="stadium-detail-item">
                @if (Model.IsOutdoor)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg> <span>Na otvorenom</span>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg> <span>Zatvoreno</span>
                }
            </span>
            <span class="stadium-detail-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                <span>@Localization.Localize(Model.SurfaceType)</span>
            </span>
        </div>
        <a asp-controller="Stadiums"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="details-button">Detalji</a>
    </div>
</div>
