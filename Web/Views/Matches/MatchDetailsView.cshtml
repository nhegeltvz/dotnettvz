@model Data.Models.MatchRecord

@{
    ViewData["Title"] = "Detalji utakmice";
    ViewData["Breadcrumbs"] = new List<Web.Helpers.BreadcrumbItem>
    {
        new("Home", "/"),
        new("Matches", "/Matches"),
        new($"{Model.PlayingField.Name} — {Model.MatchHeld.ToLocalTime():dd.MM.yyyy.}")
    };

    string GetImageMimeType(byte[] bytes)
    {
        if (bytes.Length >= 3 && bytes[0] == 0xFF && bytes[1] == 0xD8 && bytes[2] == 0xFF)
        {
            return "image/jpeg";
        }

        if (bytes.Length >= 8
            && bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47
            && bytes[4] == 0x0D && bytes[5] == 0x0A && bytes[6] == 0x1A && bytes[7] == 0x0A)
        {
            return "image/png";
        }

        if (bytes.Length >= 4 && bytes[0] == 0x47 && bytes[1] == 0x49 && bytes[2] == 0x46)
        {
            return "image/gif";
        }

        if (bytes.Length > 0 && bytes[0] == 0x3C)
        {
            return "image/svg+xml";
        }

        return "application/octet-stream";
    }

    string? GetAvatarDataUri(byte[] bytes)
        => bytes.Length > 0
            ? $"data:{GetImageMimeType(bytes)};base64,{Convert.ToBase64String(bytes)}"
            : null;

    string GetInitials(string username)
    {
        var parts = username
            .Split(['_', '-', '.'], StringSplitOptions.RemoveEmptyEntries)
            .Where(part => !string.IsNullOrWhiteSpace(part))
            .Take(2)
            .ToArray();

        if (parts.Length == 0)
        {
            return "P";
        }

        return string.Concat(parts.Select(part => char.ToUpperInvariant(part[0])));
    }

    var teamAPlayers = Model.MatchPlayers
        .Where(matchPlayer => matchPlayer.Team == Data.Data.Team.A)
        .OrderByDescending(matchPlayer => matchPlayer.Goals)
        .ThenByDescending(matchPlayer => matchPlayer.Assists)
        .ThenBy(matchPlayer => matchPlayer.Player.Username)
        .ToList();

    var teamBPlayers = Model.MatchPlayers
        .Where(matchPlayer => matchPlayer.Team == Data.Data.Team.B)
        .OrderByDescending(matchPlayer => matchPlayer.Goals)
        .ThenByDescending(matchPlayer => matchPlayer.Assists)
        .ThenBy(matchPlayer => matchPlayer.Player.Username)
        .ToList();

    var votedYesCount = Model.MatchVotes.Count(vote => vote.VotedHeld);
    var votedNoCount = Model.MatchVotes.Count(vote => !vote.VotedHeld);
    var totalGoals = Model.GoalsTeamA + Model.GoalsTeamB;
}

<div class="match-details-page">
    <a asp-controller="Matches" asp-action="Index" class="match-details-back">
        <span class="match-details-back-icon" aria-hidden="true"><i class="fa-solid fa-chevron-left"></i></span>
        Natrag na sve utakmice
    </a>

    <article class="match-details-card">
        <header class="match-details-header">
            <div class="match-details-title-wrap">
                <h1>@Model.PlayingField.Name</h1>
                <p class="match-details-date">
                    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                    @Model.MatchHeld.ToLocalTime().ToString("dd.MM.yyyy. HH:mm")
                </p>
            </div>

            <span class="match-status-badge @(Model.WasMatchHeld ? "match-status-badge--held" : "match-status-badge--not-held")">
                <i class="fa-solid @(Model.WasMatchHeld ? "fa-check" : "fa-hourglass-half")" aria-hidden="true"></i>
                @(Model.WasMatchHeld ? "Odigrana" : "Nije odigrana")
            </span>
        </header>

        <section class="match-scoreboard" aria-label="Rezultat utakmice">
            <div class="match-team match-team--a">
                <span class="match-team-label">Team A</span>
                <span class="match-team-score">@Model.GoalsTeamA</span>
            </div>
            <div class="match-score-separator" aria-hidden="true">:</div>
            <div class="match-team match-team--b">
                <span class="match-team-label">Team B</span>
                <span class="match-team-score">@Model.GoalsTeamB</span>
            </div>
        </section>

        <div class="match-details-content-grid">
            <div class="match-main-column">
                <section class="match-panel">
                    <h2 class="match-panel-title"><i class="fa-solid fa-people-group" aria-hidden="true"></i> Sastavi</h2>
                    <div class="match-rosters-grid">
                        <div class="match-roster-card">
                            <h3>Team A (@teamAPlayers.Count)</h3>
                            <ul class="match-player-list">
                                @foreach (var playerEntry in teamAPlayers)
                                {
                                    var avatarSrc = GetAvatarDataUri(playerEntry.Player.ProfilePicture);
                                    <li>
                                        @if (!string.IsNullOrWhiteSpace(avatarSrc))
                                        {
                                            <img class="match-player-avatar" src="@avatarSrc" alt="@playerEntry.Player.Username avatar" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="match-player-avatar" aria-hidden="true">@GetInitials(playerEntry.Player.Username)</div>
                                        }
                                        <a class="match-player-name" asp-controller="Players" asp-action="Details" asp-route-id="@playerEntry.Player.Id" asp-route-username="@playerEntry.Player.Username">
                                            @playerEntry.Player.Username
                                        </a>
                                        <div class="match-player-stats">
                                            <span class="match-player-chip">G @playerEntry.Goals</span>
                                            <span class="match-player-chip">A @playerEntry.Assists</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="match-roster-card">
                            <h3>Team B (@teamBPlayers.Count)</h3>
                            <ul class="match-player-list">
                                @foreach (var playerEntry in teamBPlayers)
                                {
                                    var avatarSrc = GetAvatarDataUri(playerEntry.Player.ProfilePicture);
                                    <li>
                                        @if (!string.IsNullOrWhiteSpace(avatarSrc))
                                        {
                                            <img class="match-player-avatar" src="@avatarSrc" alt="@playerEntry.Player.Username avatar" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="match-player-avatar" aria-hidden="true">@GetInitials(playerEntry.Player.Username)</div>
                                        }
                                        <a class="match-player-name" asp-controller="Players" asp-action="Details" asp-route-id="@playerEntry.Player.Id" asp-route-username="@playerEntry.Player.Username">
                                            @playerEntry.Player.Username
                                        </a>
                                        <div class="match-player-stats">
                                            <span class="match-player-chip">G @playerEntry.Goals</span>
                                            <span class="match-player-chip">A @playerEntry.Assists</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </section>

                <section class="match-panel">
                    <h2 class="match-panel-title"><i class="fa-solid fa-check-to-slot" aria-hidden="true"></i> Glasovi (@Model.MatchVotes.Count)</h2>
                    <div class="match-votes-summary">
                        <span class="match-vote-pill match-vote-pill--yes"><i class="fa-solid fa-thumbs-up" aria-hidden="true"></i> Dolazi: @votedYesCount</span>
                        <span class="match-vote-pill match-vote-pill--no"><i class="fa-solid fa-thumbs-down" aria-hidden="true"></i> Ne dolazi: @votedNoCount</span>
                    </div>
                    <ul class="match-votes-list">
                        @foreach (var vote in Model.MatchVotes.OrderBy(v => v.Player.Username))
                        {
                            <li>
                                <span class="match-vote-user">@vote.Player.Username</span>
                                <span class="match-vote-state @(vote.VotedHeld ? "match-vote-state--yes" : "match-vote-state--no")">
                                    <i class="fa-solid @(vote.VotedHeld ? "fa-check" : "fa-xmark")" aria-hidden="true"></i>
                                    @(vote.VotedHeld ? "Dolazi" : "Ne dolazi")
                                </span>
                            </li>
                        }
                    </ul>
                </section>
            </div>

            <aside class="match-side-column">
                <section class="match-panel">
                    <h2 class="match-panel-title"><i class="fa-solid fa-chart-simple" aria-hidden="true"></i> Brzi pregled</h2>
                    <div class="match-kpi-grid">
                        <div class="match-kpi-card">
                            <span class="match-kpi-label">Ukupno golova</span>
                            <span class="match-kpi-value">@totalGoals</span>
                        </div>
                        <div class="match-kpi-card">
                            <span class="match-kpi-label">Ukupno igraca</span>
                            <span class="match-kpi-value">@Model.MatchPlayers.Count</span>
                        </div>
                        <div class="match-kpi-card">
                            <span class="match-kpi-label">Team A igraca</span>
                            <span class="match-kpi-value">@teamAPlayers.Count</span>
                        </div>
                        <div class="match-kpi-card">
                            <span class="match-kpi-label">Team B igraca</span>
                            <span class="match-kpi-value">@teamBPlayers.Count</span>
                        </div>
                    </div>
                </section>

                <section class="match-panel">
                    <h2 class="match-panel-title"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Teren</h2>
                    <ul class="match-field-list">
                        <li><strong>Naziv:</strong> @Model.PlayingField.Name</li>
                        <li><strong>Status:</strong> @Model.PlayingField.Status</li>
                        <li><strong>Podloga:</strong> @Model.PlayingField.SurfaceType</li>
                        <li><strong>Tip:</strong> @(Model.PlayingField.IsOutdoor ? "Outdoor" : "Indoor")</li>
                        <li><strong>Kontakt:</strong> @Model.PlayingField.ContactNumber</li>
                    </ul>

                    <a class="match-field-link" asp-controller="Stadiums" asp-action="Details" asp-route-id="@Model.PlayingField.Id" asp-route-name="@Model.PlayingField.Name">
                        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                        Otvori detalje terena
                    </a>
                </section>
            </aside>
        </div>
    </article>
</div>
