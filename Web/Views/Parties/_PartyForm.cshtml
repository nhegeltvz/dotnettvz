@using Data.Dto.CRUD.Party
@using Web.Models.Dashboard
@using Web.Models
@model PartyFormViewModel

@{
    var attendanceHidden = Model.Form.ScheduledMatchAttendances.Any() ? string.Empty : "hidden";
}

<section class="dashboard-panel">
    <header class="dashboard-panel-header">
        <h2 class="dashboard-panel-title">Party Details</h2>
    </header>
    <form id="party-form" class="dashboard-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" id="party-id" />
        <input type="hidden" id="scheduled-match-id" value="@Model.Form.ScheduledMatchId" />
        <div id="party-edit-banner" class="dashboard-edit-banner" hidden>Editing party</div>

        <div class="dashboard-form-row">
            <label asp-for="Form.PlayerCreatedId"></label>
            <select asp-for="Form.PlayerCreatedId" asp-items="Model.Players"></select>
            <span asp-validation-for="Form.PlayerCreatedId" class="text-danger"></span>
        </div>

        <div class="dashboard-form-row">
            <label asp-for="Form.DateCreated"></label>
            @await Html.PartialAsync("_CustomDatePicker", new CustomDatePickerModel
            {
                FieldName = "Form_DateCreated",
                Value = Model.Form.DateCreated != default
                    ? Model.Form.DateCreated.ToString("yyyy-MM-ddTHH:mm")
                    : string.Empty
            })
            <span asp-validation-for="Form.DateCreated" class="text-danger"></span>
        </div>

        <div class="dashboard-form-row">
            <label asp-for="Form.MaxMembers"></label>
            <input asp-for="Form.MaxMembers" type="number" />
            <span asp-validation-for="Form.MaxMembers" class="text-danger"></span>
        </div>

        <div class="dashboard-form-row">
            <label asp-for="Form.PartyDescription"></label>
            <textarea asp-for="Form.PartyDescription"></textarea>
            <span asp-validation-for="Form.PartyDescription" class="text-danger"></span>
        </div>

        <div class="dashboard-form-row">
            <label asp-for="Form.PreferredLocations"></label>
            <textarea asp-for="Form.PreferredLocations"></textarea>
            <span asp-validation-for="Form.PreferredLocations" class="text-danger"></span>
        </div>

        <div class="dashboard-form-section dashboard-scheduled-match-section">
            <h3 class="dashboard-form-section-title">
                <i class="fa-solid fa-calendar-check"></i> Zakazani meč
            </h3>

            @if (Model.HasMatchRecord)
            {
                <div class="dashboard-match-locked-notice">
                    <i class="fa-solid fa-lock"></i>
                    <span>Rezultat meča je već evidentiran — zakazani meč se ne može mijenjati ni ukloniti.</span>
                </div>
            }

            <div class="dashboard-form-row">
                <label asp-for="Form.ScheduledMatchPlayingFieldId">Teren zakazanog meča</label>
                <select asp-for="Form.ScheduledMatchPlayingFieldId" asp-items="Model.PlayingFields"
                        @(Model.HasMatchRecord ? "disabled" : "")>
                    @if (!Model.HasMatchRecord)
                    {
                        <option value="">-- Bez zakazanog meča --</option>
                    }
                </select>
                <span asp-validation-for="Form.ScheduledMatchPlayingFieldId" class="text-danger"></span>
            </div>

            <div class="dashboard-form-row">
                <label asp-for="Form.ScheduledMatchDate">Datum zakazanog meča</label>
                @await Html.PartialAsync("_CustomDatePicker", new CustomDatePickerModel
                {
                    FieldName = "Form_ScheduledMatchDate",
                    Value = Model.Form.ScheduledMatchDate.HasValue
                        ? Model.Form.ScheduledMatchDate.Value.ToString("yyyy-MM-ddTHH:mm")
                        : string.Empty,
                    Disabled = Model.HasMatchRecord
                })
                <span asp-validation-for="Form.ScheduledMatchDate" class="text-danger"></span>
            </div>
        </div>

        <div class="dashboard-form-row">
            <label>Preferred playing dates</label>
            <div class="dashboard-date-input">
                @await Html.PartialAsync("_CustomDatePicker", new CustomDatePickerModel
                {
                    FieldName = "preferred-date-input",
                    Value = string.Empty
                })
                <button type="button" class="dashboard-button-secondary" id="add-preferred-date">Add date</button>
            </div>
            <div id="preferred-dates-list" class="dashboard-date-chip-list">
                @foreach (var date in Model.Form.PreferredPlayingDates)
                {
                    var localDate = date.ToLocalTime();
                    <div class="dashboard-date-chip" data-date="@date.ToString("yyyy-MM-ddTHH:mm")">
                        <span>@localDate.ToString("dd.MM.yyyy. HH:mm")</span>
                        <button type="button" class="dashboard-chip-remove" aria-label="Remove date">X</button>
                    </div>
                }
            </div>
        </div>

        <div class="dashboard-form-row">
            @await Html.PartialAsync("_HegelMultiSelect", Model.HmsPartyMembers)
        </div>

        <div id="scheduled-attendance-section" class="dashboard-form-section" @attendanceHidden>
            <h3 class="dashboard-form-section-title">Scheduled match attendance</h3>
            <table class="dashboard-table dashboard-table--compact" aria-label="Scheduled match attendance">
                <thead>
                    <tr>
                        <th>Player</th>
                        <th>Attending</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attendance in Model.Form.ScheduledMatchAttendances)
                    {
                        <tr data-player-id="@attendance.PlayerId" data-attendance-id="@attendance.Id">
                            <td>@attendance.PlayerName</td>
                            <td>
                                <input type="checkbox" class="attendance-toggle" @(attendance.IsAttending ? "checked" : string.Empty) />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="dashboard-form-actions">
            <button type="button" class="dashboard-button-secondary" onclick="cancelForm()">Cancel</button>
            <button type="button" class="dashboard-submit" onclick="submitForm()">Save</button>
        </div>
    </form>
</section>
